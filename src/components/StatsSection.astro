---
import StatCard from './StatCard.astro';
---

<div class="stats-container">
    <div id="container-total-spent" class="stat-interactive">
        <StatCard label="Gastos Mensuales" value="$0.00" color="blue" />
    </div>

    <div id="container-subs-count" style="flex:1">
        <StatCard label="Suscripciones Activas" value="0" color="green" />
    </div>

    <div id="container-next-payment" style="flex:1">
        <StatCard label="Próximo Pago" value="—" color="purple" />
    </div>

    <div id="container-budget-pct" style="flex:1">
        <StatCard label="Presupuesto Usado" value="0%" color="orange" />
    </div>
</div>

<script>
    import { $subscriptions } from '../store/subscriptions';
    import { $budgets } from '../store/budgets';

    const MONTHS = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

    const getNextPayment = (subs: any[]) => {
        const today = new Date();
        let nextDate: Date | null = null;
        let nextName = '—';

        for (const sub of subs) {
            if (!sub.date) continue;
            const d = new Date(sub.date + 'T00:00:00');
            if (isNaN(d.getTime())) continue;

            const thisYear = new Date(today.getFullYear(), d.getMonth(), d.getDate());
            if (thisYear < today) {
                thisYear.setFullYear(today.getFullYear() + 1);
            }

            if (!nextDate || thisYear < nextDate) {
                nextDate = thisYear;
                nextName = sub.name;
            }
        }

        return { date: nextDate, name: nextName };
    };

    const updateUI = () => {
        const subs = $subscriptions.get();
        const budgets = $budgets.get();

        const totalBudget = budgets[budgets.length - 1];

        const spentEl = document.querySelector('#container-total-spent .stat-value');
        const countEl = document.querySelector('#container-subs-count .stat-value');
        const nextEl = document.querySelector('#container-next-payment .stat-value');
        const pctEl = document.querySelector('#container-budget-pct .stat-value');

        if (countEl) {
            countEl.textContent = subs.length.toString();
        }

        if (totalBudget) {
            if (spentEl) {
                spentEl.textContent = `$${totalBudget.currentSpent.toFixed(2)}`;
            }

            if (pctEl) {
                const percentage = totalBudget.limit > 0 ? Math.round((totalBudget.currentSpent / totalBudget.limit) * 100) : 0;
                pctEl.textContent = `${percentage}%`;
            }
        }

        if (nextEl) {
            const { date, name } = getNextPayment(subs);
            if (date) {
                nextEl.textContent = `${name} · ${date.getDate()} ${MONTHS[date.getMonth()]}`;
            } else {
                nextEl.textContent = '—';
            }
        }
    };

    $subscriptions.subscribe(updateUI);
    $budgets.subscribe(updateUI);

    updateUI();

    document.addEventListener('astro:after-swap', updateUI);
</script>

<style>
    .stats-container {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-interactive {
        flex: 1;
        cursor: pointer;
        transition: transform 0.2s ease;
    }

    .stat-interactive:hover {
        transform: translateY(-3px);
    }
</style>
