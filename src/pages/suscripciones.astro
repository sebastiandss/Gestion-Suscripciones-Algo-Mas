---
import MainLayout from '../layout/MainLayout.astro';
import FilterBar from '../components/FilterBar.astro';
import SubscriptionsGrid from '../components/SubscriptionsGrid/SubscriptionsGrid.astro';
---

<MainLayout>
    <div class="header-section">
        <div class="title-info">
            <h1>Suscripciones</h1>
            <p id="sub-header-subtitle">Monitoreo y gestión de tus gastos fijos</p>
        </div>
        <div class="header-actions">
            <div class="total-pill" id="total-pill">
                Total: <span id="total-amount">$0.00</span> / mes
            </div>
        </div>
    </div>

    <FilterBar />

    <SubscriptionsGrid />
</MainLayout>

<script>
    import { $subscriptions, $totalGastos } from '../store/subscriptions';

    const MONTHS = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
    const today = new Date();
    const currentMonth = `${MONTHS[today.getMonth()]} ${today.getFullYear()}`;

    const updateHeader = () => {
        const subs = $subscriptions.get();
        const totalEl = document.getElementById('total-amount');
        const subtitleEl = document.getElementById('sub-header-subtitle');

        const total = subs.reduce((acc, s) => acc + (parseFloat(s.price) || 0), 0);
        const activas = subs.filter(s => s.status === 'Activo').length;

        if (totalEl) totalEl.textContent = `$${total.toFixed(2)}`;
        if (subtitleEl) {
            const count = subs.length;
            if (count === 0) {
                subtitleEl.textContent = 'Aún no tienes suscripciones registradas';
            } else if (count === 1) {
                subtitleEl.textContent = `1 suscripción · ${activas} activa · ${currentMonth}`;
            } else {
                subtitleEl.textContent = `${count} suscripciones · ${activas} activas · ${currentMonth}`;
            }
        }
    };

    $subscriptions.subscribe(updateHeader);
    updateHeader();
    document.addEventListener('astro:after-swap', updateHeader);
</script>

<style>
    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 24px;
    }
    .title-info h1 {
        font-size: 2rem;
        font-weight: 700;
        color: white;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
    }
    .title-info p {
        color: #484848;
        font-size: 0.9rem;
        letter-spacing: 0.3px;
        margin: 0;
    }
    .header-actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }
    .total-pill {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 20px;
        padding: 8px 16px;
        font-size: 0.8rem;
        color: #555;
        font-weight: 600;
    }
    .total-pill span {
        color: #3b82f6;
        font-variant-numeric: tabular-nums;
    }
</style>
